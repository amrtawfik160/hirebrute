# Optional. Copy to .env only if you want to override a default.
# API keys do not belong here. Enter them on the Settings page.
# They are stored in data/store.json, which git ignores.

# Directory for the local store. Default: ./data
# JOBDESK_DATA=./data

# Vite port. Default: 4317
# PORT=4317

# Express port. Default: 4318
# JOBDESK_API_PORT=4318
